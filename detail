<!doctype html>
<html lang="vi" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Chi tiết sản phẩm đồ ăn vặt Kat, tùy chỉnh hương vị và đặt hàng nhanh chóng.">
  <meta name="theme-color" content="#FFFFFF">
  <title>Chi tiết sản phẩm — Kat</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="opendesigner/build/css/tokens.css">
  <link rel="stylesheet" href="css/style.css">
</head>
<body class="inner-page menu-page">
  <a class="skip-link" href="#main-content">Bỏ qua điều hướng</a>
  
  <header class="site-header">
    <div class="header-inner page-container">
      <a class="brand-lockup" href="index.html" aria-label="Kat, về trang chủ"><img class="brand-logo" src="images/kat-logo.png" alt=""></a>
      <nav class="main-nav" aria-label="Điều hướng chính">
        <a class="nav-link" href="menu.html">Thực đơn</a>
        <a class="nav-link" href="offers.html">Ưu đãi hôm nay</a>
        <a class="nav-link" href="orders.html">Đơn hàng</a>
        <a class="nav-link" href="stores.html">Cửa hàng</a>
        <a class="nav-link" href="feedback.html">Góp ý</a>
      </nav>
      <div class="header-tools">
        <a class="icon-tool cart-tool" href="cart.html" aria-label="Giỏ hàng" title="Giỏ hàng">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h2l2.2 11.1a2 2 0 0 0 2 1.6h8.1a2 2 0 0 0 1.9-1.4L21 8H6"></path><circle cx="10" cy="20" r="1"></circle><circle cx="18" cy="20" r="1"></circle></svg>
          <span class="cart-count" data-cart-count>0</span>
        </a>
        <span class="auth-slot">
          <a class="icon-tool account-login-link" href="login.html" aria-label="Đăng nhập" title="Đăng nhập">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="3.4"></circle><path d="M5.4 20a6.6 6.6 0 0 1 13.2 0"></path></svg>
          </a>
        </span>
      </div>
    </div>
  </header>

  <main id="main-content" class="catalog-main page-container">
    <section class="menu-section" aria-label="Chi tiết sản phẩm">
      <div style="margin-bottom: var(--ds-space-16);">
        <a href="menu.html" class="button button-secondary" style="display: inline-flex; width: auto;">← Quay lại thực đơn</a>
      </div>

      <div class="product-detail" style="background: var(--ds-color-surface-raised); padding: var(--ds-space-24); border: 1px solid var(--ds-color-border-default); border-radius: var(--ds-radius-container); box-shadow: var(--ds-elevation-raised);">
        <!-- Hiển thị đúng ảnh của sản phẩm thay vì logo -->
        <div>
          <img class="detail-image" src="" alt="Hình ảnh sản phẩm" id="detail-img">
        </div>

        <!-- Thông tin chi tiết sản phẩm -->
        <div class="detail-copy">
          <span class="product-tag" style="position: static; display: inline-block; margin-bottom: var(--ds-space-8);">Best Seller</span>
          <h1 id="detail-title" style="margin: 0 0 var(--ds-space-8); font: var(--ds-text-title-lg);">Tên sản phẩm</h1>
          <p class="detail-description" id="detail-desc">Mô tả chi tiết thành phần và hương vị món ăn.</p>
          
          <div class="detail-price" id="detail-price">0đ</div>

          <div class="detail-options">
            <fieldset class="option-group">
              <legend>Chọn kích thước / phần ăn</legend>
              <div class="option-list">
                <label class="option-row">
                  <input type="radio" name="size" checked>
                  <span>Phần tiêu chuẩn</span>
                  <strong>+0đ</strong>
                </label>
                <label class="option-row">
                  <input type="radio" name="size">
                  <span>Phần đặc biệt (Nhiều topping)</span>
                  <strong>+10.000đ</strong>
                </label>
              </div>
            </fieldset>

            <fieldset class="option-group">
              <legend>Tùy chọn vị cay <span class="optional-label">(Tùy chọn)</span></legend>
              <div class="option-list">
                <label class="option-row">
                  <input type="radio" name="spicy" checked>
                  <span>Không cay</span>
                </label>
                <label class="option-row">
                  <input type="radio" name="spicy">
                  <span>Cay vừa</span>
                </label>
                <label class="option-row">
                  <input type="radio" name="spicy">
                  <span>Cay nhiều</span>
                </label>
              </div>
            </fieldset>

            <div class="quantity-field">
              <label for="product-qty">Số lượng</label>
              <input type="number" id="product-qty" value="1" min="1" max="99">
            </div>

            <button type="button" class="button button-primary button-wide" id="btn-add-to-cart">Thêm vào giỏ hàng</button>
          </div>
        </div>
      </div>
    </section>
  </main>

  <div id="toast-region" class="toast-region" aria-live="polite" aria-atomic="false"></div>

  <script src="js/initdata.js"></script>
  <script src="js/toast.js"></script>
  <script src="js/auth.js"></script>
  <script src="js/main.js"></script>

  <!-- Script nhận dữ liệu sản phẩm từ trang menu truyền sang -->
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const urlParams = new URLSearchParams(window.location.search);
      const name = urlParams.get("name");
      const price = urlParams.get("price");
      const img = urlParams.get("img");
      const desc = urlParams.get("desc");

      if (name) document.getElementById("detail-title").textContent = name;
      if (price) document.getElementById("detail-price").textContent = price;
      if (img) document.getElementById("detail-img").src = img;
      if (desc) document.getElementById("detail-desc").textContent = desc;

      const addToCartBtn = document.getElementById("btn-add-to-cart");
      if (addToCartBtn) {
        addToCartBtn.addEventListener("click", function (e) {
          e.preventDefault();
          if (typeof showToast === "function") {
            showToast("Đã thêm sản phẩm vào giỏ hàng", "success");
          }
        });
      }
    });
  </script>
</body>
</html>
