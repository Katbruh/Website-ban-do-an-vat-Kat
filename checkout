<!doctype html>
<html lang="vi" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Thanh toán đơn hàng tại Kat - Đồ ăn vặt.">
  <meta name="theme-color" content="#FFFFFF">
  <title>Thanh toán — Kat</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="opendesigner/build/css/tokens.css">
  <link rel="stylesheet" href="css/style.css">
  <style>
    .checkout-container {
      max-width: 900px;
      margin: 0 auto;
      background: var(--ds-color-surface-raised, #ffffff);
      padding: 36px;
      border: 1px solid #e5e7eb;
      border-radius: 16px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    }
    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 24px;
    }
    .form-group {
      margin-bottom: 4px;
    }
    .form-group.full {
      grid-column: span 2;
    }
    .form-group label {
      display: block;
      font-weight: 600;
      font-size: 13px;
      margin-bottom: 8px;
      color: #1f2937;
    }
    .form-group input, .form-group select, .form-group textarea {
      width: 100%;
      padding: 12px 14px;
      border: 1.5px solid #d1d5db;
      border-radius: 8px;
      font-size: 14px;
      background: #f9fafb;
      transition: all 0.2s ease;
    }
    .form-group input:focus, .form-group select:focus {
      border-color: #C0392B;
      background: #fff;
      outline: none;
      box-shadow: 0 0 0 3px rgba(192, 57, 43, 0.1);
    }
    .checkout-summary {
      background: #fff5f5;
      padding: 24px;
      border-radius: 12px;
      margin-bottom: 28px;
      border: 1.5px dashed #f5c6cb;
    }
    .summary-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 12px;
      font-size: 14px;
      color: #4b5563;
    }
    .summary-row.total {
      font-size: 18px;
      font-weight: 700;
      color: #111;
      border-top: 1px solid #f5c6cb;
      padding-top: 14px;
      margin-top: 14px;
    }
    #btn-submit-order {
      background: linear-gradient(135deg, #C0392B, #962d22);
      transition: opacity 0.2s, transform 0.1s;
    }
    #btn-submit-order:hover {
      opacity: 0.95;
      transform: translateY(-1px);
    }
  </style>
</head>
<body class="inner-page checkout-page">
  <a class="skip-link" href="#main-content">Bỏ qua điều hướng</a>
  
  <header class="site-header">
    <div class="header-inner page-container">
      <a class="brand-lockup" href="index.html" aria-label="Kat, về trang chủ"><img class="brand-logo" src="images/kat-logo.png" alt=""></a>
      <nav class="main-nav" aria-label="Điều hướng chính">
        <a class="nav-link" href="menu.html">Thực đơn</a>
        <a class="nav-link" href="offers.html">Ưu đãi hôm nay</a>
        <a class="nav-link" href="orders.html">Đơn hàng</a>
        <a class="nav-link" href="stores.html">Cửa hàng</a>
        <a class="nav-link" href="feedback.html">Góp ý</a>
      </nav>
      <div class="header-tools">
        <a class="icon-tool cart-tool" href="cart.html" aria-label="Giỏ hàng" title="Giỏ hàng">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h2l2.2 11.1a2 2 0 0 0 2 1.6h8.1a2 2 0 0 0 1.9-1.4L21 8H6"></path><circle cx="10" cy="20" r="1"></circle><circle cx="18" cy="20" r="1"></circle></svg>
          <span class="cart-count" data-cart-count>1</span>
        </a>
        <span class="auth-slot">
          <a class="icon-tool account-login-link" href="login.html" aria-label="Đăng nhập" title="Đăng nhập">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="3.4"></circle><path d="M5.4 20a6.6 6.6 0 0 1 13.2 0"></path></svg>
          </a>
        </span>
      </div>
    </div>
  </header>

  <main id="main-content" class="catalog-main page-container">
    <section class="menu-section" aria-label="Trang thanh toán">
      <div class="checkout-container">
        <div style="margin-bottom: 20px;">
          <a href="cart.html" class="button button-secondary" style="display: inline-flex; width: auto; font-size: 13px; padding: 6px 14px; border-radius: 6px;">← Quay lại giỏ hàng</a>
        </div>

        <h1 style="margin-top: 0; margin-bottom: 28px; font-size: 24px; font-weight: 700; color: #111;">Xác nhận thanh toán</h1>

        <!-- Form thông tin giao hàng (Tĩnh) -->
        <form id="checkout-form">
          <div class="form-grid">
            <div class="form-group">
              <label for="fullname">Họ và tên</label>
              <input type="text" id="fullname" placeholder="Nhập họ tên của bạn" value="Nguyễn Văn An" autocomplete="off">
            </div>
            <div class="form-group">
              <label for="phone">Số điện thoại</label>
              <input type="text" id="phone" placeholder="Nhập số điện thoại" value="0912345601" autocomplete="off">
            </div>
            <div class="form-group full">
              <label for="address">Địa chỉ nhận hàng</label>
              <input type="text" id="address" placeholder="Nhập địa chỉ nhận hàng" value="Số 123, Đường Nguyễn Văn Cừ, Quận 5, TP.HCM" autocomplete="off">
            </div>
            <div class="form-group">
              <label for="payment-method">Hình thức thanh toán</label>
              <select id="payment-method">
                <option value="cod">Thanh toán khi nhận hàng (COD)</option>
                <option value="momo">Ví MoMo</option>
                <option value="banking">Chuyển khoản ngân hàng (MBBank)</option>
              </select>
            </div>
            <div class="form-group">
              <label for="note">Ghi chú cho quán</label>
              <input type="text" id="note" placeholder="Ví dụ: Giao nhanh giúp mình nhé" value="Ít cay" autocomplete="off">
            </div>
          </div>

          <!-- Tóm tắt đơn hàng cố định (Được tô điểm nổi bật) -->
          <div class="checkout-summary">
            <h3 style="margin-top: 0; margin-bottom: 14px; font-size: 16px; font-weight: 700; color: #962d22;">Tóm tắt đơn hàng (1 sản phẩm)</h3>
            <div class="summary-row">
              <span>Bánh tráng (Phần tiêu chuẩn, Không cay) x1</span>
              <strong style="color: #111;">25.000đ</strong>
            </div>
            <div class="summary-row">
              <span>Phí vận chuyển</span>
              <strong style="color: #065f46;">Miễn phí</strong>
            </div>
            <div class="summary-row total">
              <span>Tổng thanh toán:</span>
              <span style="color: #C0392B; font-size: 20px;">25.000đ</span>
            </div>
          </div>

          <!-- Nút đặt hàng nổi bật -->
          <div>
            <button type="button" class="button button-primary button-wide" id="btn-submit-order" style="cursor: pointer; padding: 14px; font-size: 16px; font-weight: 700; border-radius: 8px; box-shadow: 0 4px 12px rgba(192, 57, 43, 0.3);">Hoàn tất đặt hàng</button>
          </div>
        </form>
      </div>
    </section>
  </main>

  <div id="toast-region" class="toast-region" aria-live="polite" aria-atomic="false"></div>

  <script src="js/initdata.js"></script>
  <script src="js/toast.js"></script>
  <script src="js/auth.js"></script>

  <!-- Script chặn hành động thật, hiển thị thông báo "Đã áp dụng" khi bấm đặt hàng -->
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const btnSubmitOrder = document.getElementById("btn-submit-order");
      if (btnSubmitOrder) {
        btnSubmitOrder.addEventListener("click", function (e) {
          e.preventDefault();
          e.stopImmediatePropagation();
          if (typeof showToast === "function") {
            showToast("Đã áp dụng", "success");
          }
        }, true);
      }
    });
  </script>
</body>
</html>
